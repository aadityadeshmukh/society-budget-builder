                <div className="grid grid-cols-1 gap-3">
                  {cat.logic === 'Construction-Based' ? (
                    <div className="bg-teal-50/50 p-4 rounded-lg border border-teal-100 flex items-start gap-3">
                      <Info size={16} className="text-teal-600 mt-0.5" />
                      <div className="text-sm text-teal-800">
                        <p className="font-bold">Statutory Collection Active</p>
                        <p className="opacity-80">This type follows a fixed percentage of construction cost ({cat.rate}% p.a.) as per bye-laws. Individual expense entries are not required for billing.</p>
                      </div>
                    </div>
                  ) : (
                    expenses.filter(e => e.categoryId === cat.id).length === 0 ? (
                      <div className="py-4 text-center border-2 border-dashed border-slate-100 rounded-xl">
                        <p className="text-sm text-slate-400 italic">No bill records added for this category yet.</p>
                      </div>
                    ) : (
                      expenses.filter(e => e.categoryId === cat.id).map(expense => {
                        const variance = expense.lastYearAmount ? ((expense.thisYearAmount / expense.lastYearAmount) - 1) * 100 : 0;
                        return (
                          <div key={expense.id} className="flex justify-between items-center bg-white p-3 rounded-lg border border-slate-100 group">
                            <div className="flex items-center gap-3">
                               <div className="w-8 h-8 rounded bg-teal-50 flex items-center justify-center text-teal-600">
                                 <Tag size={14} />
                               </div>
                               <div>
                                  <span className="font-medium block text-sm">{expense.name}</span>
                                  <span className="text-[10px] text-slate-400">LY: ₹{expense.lastYearAmount.toLocaleString()}</span>
                               </div>
                            </div>
                            <div className="flex items-center gap-6">
                              <div className="text-right">
                                 <span className="font-mono font-bold block text-sm">₹{expense.thisYearAmount.toLocaleString()}</span>
                                 <span className={`text-[10px] flex items-center justify-end gap-0.5 ${variance > 0 ? 'text-rose-500' : 'text-emerald-500'}`}>
                                   {variance > 0 ? <ArrowUpRight size={10} /> : <ArrowDownRight size={10} />}
                                   {Math.abs(variance).toFixed(1)}%
                                 </span>
                              </div>
                              <button onClick={() => deleteExpense(expense.id)} className="opacity-0 group-hover:opacity-100 text-slate-300 hover:text-brick-500 transition-all"><Trash2 size={16} /></button>
                            </div>
                          </div>
                        );
                      })
                    )
                  )}
                </div>
